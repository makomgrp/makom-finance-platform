# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example carries NO real values — only variable names and safe
# placeholders — and is the one file that documents what a deployment needs.
# It must stay tracked (Milestone 23).
!.env.example

# MCP server configuration (Milestone 23).
# .mcp.json embeds a Supabase MCP endpoint URL that carries an access
# credential. It was untracked but NOT ignored through Milestones 16-22, so a
# single `git add .` would have committed that credential; it survived only
# because every commit was explicitly path-staged. Ignoring it removes the
# accident entirely. Local-only by design — never commit it.
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
